# Copia este archivo a .env.local (o ejecuta `npm run setup`, que lo genera con secretos aleatorios).
# .env.local está en .gitignore: nunca subas valores reales a ningún repositorio.

# Contraseña del panel /admin (elige una larga; `npm run setup` genera una aleatoria)
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión del admin (mínimo 32 caracteres aleatorios)
ADMIN_SESSION_SECRET=

# Opcional: IPs que pueden entrar al admin, separadas por coma. Vacío = cualquiera (con contraseña)
ADMIN_ALLOWED_IPS=

# Opcional: horas de validez de la sesión del admin (por defecto 12, máximo 168)
ADMIN_SESSION_MAX_AGE_HOURS=

# Opcional: URL pública del sitio (sitemap, robots, metadatos)
NEXT_PUBLIC_SITE_URL=

# Opcional: carpeta donde se guardan propiedades, leads y fotos (por defecto ./data)
ILLAN_DATA_DIR=
